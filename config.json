{
  "log_level": "INFO",
  "embedding_model_name": "sentence-transformers/all-MiniLM-L6-v2",
  "collection_name": "documents",
  "retriever_min_score_threshold": "0.5",
  "llm_api_url": "http://host.docker.internal:11434/api/generate",
  "llm_model_name": "llama3.1:8b",
  "llm_provider": "ollama",
  "raw_input_directory": "data/raw_input",
  "cleaned_text_directory": "data/cleaned_text",
  "embeddings_directory": "data/embeddings",
  "vectordb_directory": "data/vectordb",
  "cors_allowed_origins": ["http://localhost:3000", "http://localhost:8080"],
  "chromadb_host": "localhost",
  "chromadb_port": 8000,
  "store_vectors_locally": true,
  "use_langchain": true,
  "chunk_size": 1000,
  "chunk_overlap": 200,
  "cache": {
    "enabled": true,
    "redis_host": "localhost",
    "redis_port": 6379,
    "redis_db": 0,
    "ttl_seconds": {
      "llm_responses": 3600,
      "document_retrieval": 1800,
      "query_responses": 900,
      "embeddings": 7200
    },
    "max_cache_size_mb": 100
  }
